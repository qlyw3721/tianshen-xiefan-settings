# ============================================================
# 《天神下凡》设定工程 —— Git 忽略规则（双机同步方案 B：仅管文本源）
# 说明：二进制/派生产物与本地回滚备份统一交给「百度网盘同步盘」（方案 A）同步，
#       Git 只纳入可版本化的文本源（.md / .txt / .svg / .py），便于追溯与冲突合并。
# ============================================================

# ---------- 二进制 / 派生产物：由云盘同步，不入 Git ----------
*.docx
*.epub
*.xmind
# 族徽图片目录（10 张族徽图，二进制）
族徽/

# ---------- 本地回滚备份：由云盘同步，不入 Git ----------
_bak_*

# ---------- 资料库增量同步的本机局部状态（不可跨机共享） ----------
.lib_sync_state.json

# ---------- Python 缓存 ----------
__pycache__/
*.pyc

# ---------- WorkBuddy 项目内部目录（自动生成，非源稿） ----------
.workbuddy/

# ---------- 百度网盘同步盘的本地镜像目录（网盘同步盘自身产物，不入 Git） ----------
BaiduSyncdisk/

# ============================================================
# 以下类型的文件【会被 Git 正常跟踪】（无需忽略）：
#   *.md  *.txt  *.svg  *.py
# 含：设定集/总纲/参考库/游戏大纲/角色详设/续写正文 的 .md 源稿、
#     前后传原文 .txt、世界地图 .svg、make_epub.py、_lib_sync.py 等。
# ============================================================
